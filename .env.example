# Copy to .env (or set as stack variables in your deploy tool). See README for every setting.
INVITE_HOST=invite.example.com
LOGIN_URL=https://auth.example.com
HOME_URL=https://home.example.com/
SITE_NAME=example.com
LLDAP_BASE_DN=dc=example,dc=com
SMTP_HOST=smtp.example.com

# Optional
# ADMIN_GROUP=invite-users
# LLDAP_USER=invite-svc
# SMTP_PORT=587
# STYLE_PATH=/path/to/style.bridgewater   (checkout of the style repo at a release tag)
# SIGNATURE=teal
# APP_NAME=invites
# APPS_URL=https://hub.example.com/api/apps
# PUID=1000
# PGID=1000
# INVITES_DATA=./data
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=https
# TRAEFIK_MIDDLEWARES=authelia@docker

# Secrets go in user-invites.env next to compose.yaml, not here:
#   LLDAP_PASSWORD=...
#   SMTP_USER=...
#   SMTP_PASSWORD=...
#   SMTP_FROM=example.com <accounts@example.com>
